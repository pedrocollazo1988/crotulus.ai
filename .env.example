# ---------------------------------------------------------------------------
# Variables de entorno de C-ROTULUS IA
# Copia este fichero a `.env.local` para desarrollo y configura las mismas
# variables en Vercel (Settings -> Environment Variables) para produccion.
# ---------------------------------------------------------------------------

# --- Base de datos (Neon / PostgreSQL) -------------------------------------
# DATABASE_URL: cadena con *pooling* (host -pooler) -> la usa la app en runtime.
# DIRECT_URL:   cadena directa (sin pooling) -> la usan las migraciones.
# En Neon las encuentras en el panel del proyecto ("Connection string").
DATABASE_URL="postgresql://usuario:contrasena@ep-xxx-pooler.eu-central-1.aws.neon.tech/crotulus?sslmode=require"
DIRECT_URL="postgresql://usuario:contrasena@ep-xxx.eu-central-1.aws.neon.tech/crotulus?sslmode=require"

# --- Sitio ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://crotulus.ai"
NEXT_PUBLIC_CONTACT_EMAIL="crotulus.mipyme@gmail.com"
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_CONTACT_ADDRESS=""

# --- Widget de chat (CreatuAgente) -----------------------------------------
# URL del script del widget flotante. Vacio = no se carga el widget.
NEXT_PUBLIC_CHAT_WIDGET_URL="https://api.creatuagente.io/widget/cmv8ia68j0f3j0bs6190merf8/widget-profile.js"

# --- Correo de notificacion (SMTP) -----------------------------------------
# Cada mensaje del formulario genera un aviso a CONTACT_EMAIL.
# Con Gmail necesitas una "contrasena de aplicacion" (no la del correo).
CONTACT_EMAIL="crotulus.mipyme@gmail.com"
MAIL_FROM="C-ROTULUS IA <crotulus.mipyme@gmail.com>"
MAIL_SMTP_HOST="smtp.gmail.com"
MAIL_SMTP_PORT="465"
MAIL_SMTP_USER="crotulus.mipyme@gmail.com"
MAIL_SMTP_PASS=""

# --- HubSpot CRM ------------------------------------------------------------
# Token de una app privada con permisos de escritura sobre contactos.
# Si se deja vacio, el mensaje solo se guarda en la base de datos.
HUBSPOT_TOKEN=""

# --- Proteccion del panel de contactos --------------------------------------
# Contrasena para /admin/contactos (si esta vacia, el panel queda deshabilitado).
ADMIN_PASSWORD=""
